// ==UserScript==
// @name         YouTube Pre-Download Ad Vaporizer (Stealth Shield V7.1 - Master Edition)
// @namespace    https://techforge.elite/yt-ad-vaporizer-v7
// @version      7.1.0-Master
// @description  Mencegat, memblokir URL stream iklan, menghapus metadata, dan memusnahkan seluruh aset iklan seakar-akarnya sebelum terunduh.
// @author       TechForge Elite Ultimate & RobiMC1
// @match        *://*.youtube.com/*
// @match        *://*.youtube-nocookie.com/*
// @grant        none
// @run-at       document-start
// ==/UserScript==

(function () {
    'use strict';

    const CONFIG = {
        maxAdDurationThreshold: 120, // Video/segmen < 120 detik otomatis diidentifikasi sebagai potensi iklan
        pollIntervalMs: 5            // Polling eksekusi ultra-cepat (5ms)
    };

    // 0. VISUAL STEALTH SHIELD (BLACKOUT PANEL)
    const style = document.createElement('style');
    style.textContent = `
        #movie_player[data-stealth-blackout="active"] video {
            opacity: 0 !important;
            filter: brightness(0) !important;
        }
        #movie_player[data-stealth-blackout="active"]::after {
            content: "";
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-color: #000000 !important;
            color: #00ff66;
            font-family: monospace, sans-serif;
            font-size: 14px;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 2147483647;
            pointer-events: none;
        }
    `;
    (document.head || document.documentElement).appendChild(style);

    // 1. LAYER 0: PRE-FETCH DATA STRIPPING (Sanitize Payload & Metadata)
    function sanitizePlayerPayload(data) {
        if (!data || typeof data !== 'object') return data;

        delete data.adPlacements;
        delete data.playerAds;
        delete data.adSlots;
        delete data.adBreakHeartbeatParams;

        if (Array.isArray(data.adPlacements)) {
            data.adPlacements = data.adPlacements.filter(placement => {
                const duration = placement?.adPlacementRenderer?.config?.adPlacementConfig?.timeOffsetGaps?.[0]?.durationMillis;
                return duration ? (duration / 1000) >= CONFIG.maxAdDurationThreshold : false;
            });
        }

        if (data.playerResponse) {
            delete data.playerResponse.adPlacements;
            delete data.playerResponse.playerAds;
        }

        return data;
    }

    // Hijack JSON.parse untuk netralisir payload sebelum di-evaluate
    const nativeJSONParse = JSON.parse;
    JSON.parse = function (text, reviver) {
        const obj = nativeJSONParse.apply(this, arguments);
        if (obj && typeof obj === 'object') {
            if (obj.adPlacements || obj.playerAds || obj.playerResponse) {
                return sanitizePlayerPayload(obj);
            }
        }
        return obj;
    };

    // Hijack Initial Player Response Property
    let rawInitialResponse = window.ytInitialPlayerResponse;
    Object.defineProperty(window, 'ytInitialPlayerResponse', {
        get: () => rawInitialResponse,
        set: (val) => {
            rawInitialResponse = sanitizePlayerPayload(val);
        },
        configurable: true
    });

    // 2. LAYER 1: NETWORK STREAM & ASSET BLOCKING (Block Download Requests)
    const nativeFetch = window.fetch;
    window.fetch = async function (...args) {
        const url = typeof args[0] === 'string' ? args[0] : args[0]?.url || '';

        if (
            url.includes('doubleclick.net') ||
            url.includes('/pagead/') ||
            url.includes('/ptracking') ||
            url.includes('googleadservices.com') ||
            (url.includes('googlevideo.com') && url.includes('&ctier=L'))
        ) {
            return new Response('', { status: 200, statusText: 'OK' });
        }

        if (url.includes('/youtubei/v1/player') || url.includes('/youtubei/v1/next')) {
            const response = await nativeFetch.apply(this, args);
            const clone = response.clone();
            try {
                const data = await clone.json();
                return new Response(JSON.stringify(sanitizePlayerPayload(data)), {
                    status: response.status,
                    statusText: response.statusText,
                    headers: response.headers
                });
            } catch (e) {
                return response;
            }
        }
        return nativeFetch.apply(this, args);
    };

    // 3. LAYER 2: ROOT DOM & AD NODE EVICTION
    const AD_ROOT_SELECTORS = [
        'ytd-ad-slot-renderer',
        'ytd-in-feed-ad-layout-renderer',
        'ytd-banner-promo-renderer',
        'ytd-statement-banner-renderer',
        '.ytp-ad-overlay-container',
        '.ytp-ad-message-container',
        '#player-ads',
        'ytd-display-ad-renderer',
        'ytd-promoted-sparkles-web-renderer'
    ];

    function purgeRootAdNodes() {
        AD_ROOT_SELECTORS.forEach(selector => {
            const elements = document.querySelectorAll(selector);
            elements.forEach(node => node.remove());
        });
    }

    function setStealthShield(active, player) {
        if (!player) return;
        if (active) {
            if (player.getAttribute('data-stealth-blackout') !== 'active') {
                player.setAttribute('data-stealth-blackout', 'active');
            }
        } else {
            if (player.hasAttribute('data-stealth-blackout')) {
                player.removeAttribute('data-stealth-blackout');
            }
        }
    }

    function processVideoState() {
        const player = document.querySelector('#movie_player') || document.querySelector('.html5-video-player');
        const video = document.querySelector('video');

        if (!video || !player) return;

        const duration = video.duration;
        const isAdShowing = player.classList.contains('ad-showing') ||
                            player.classList.contains('ad-interrupting') ||
                            !!document.querySelector('.ytp-ad-player-overlay');

        const isShortAdDuration = !isNaN(duration) && duration > 0 && duration < CONFIG.maxAdDurationThreshold && player.classList.contains('ad-created');

        if (isAdShowing || isShortAdDuration) {
            setStealthShield(true, player);

            video.muted = true;
            video.playbackRate = 46.0;

            if (isFinite(duration) && duration > 0) {
                video.currentTime = duration - 0.001;
            }

            const skipBtn = player.querySelector('.ytp-ad-skip-button, .ytp-ad-skip-button-modern, .ytp-skip-ad-button');
            if (skipBtn) {
                skipBtn.removeAttribute('disabled');
                skipBtn.click();
            }

            purgeRootAdNodes();
        } else {
            setStealthShield(false, player);
        }
    }

    // 4. LAYER 3: REAL-TIME MUTATION & EXECUTION
    const nativePlay = HTMLMediaElement.prototype.play;
    HTMLMediaElement.prototype.play = function () {
        processVideoState();
        return nativePlay.apply(this, arguments);
    };

    const observer = new MutationObserver(() => {
        purgeRootAdNodes();
        processVideoState();
    });

    function init() {
        purgeRootAdNodes();
        processVideoState();

        observer.observe(document.documentElement, {
            childList: true,
            subtree: true,
            attributes: true,
            attributeFilter: ['class', 'src']
        });

        setInterval(() => {
            purgeRootAdNodes();
            processVideoState();
        }, CONFIG.pollIntervalMs);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
