! ===============================================================================
! Title: yt vaporizer v3 (Maximum Premium Architecture)
! Repository: RobiMC1/yt-ad-vaporizer-filter
! Capability: Network Blocking + Response Pruning + Anti-Adblock Defuser + Privacy + UI Repair
! Engine Target: uBlock Origin 1.50+ / AdGuard 7.10+
! ===============================================================================

! -------------------------------------------------------------------------------
! DIMENSI 1: PEMBLOKIRAN JARINGAN (NETWORK REQUEST BLOCKING)
! Mematikan koneksi ke server iklan & pelacak di tingkat paling bawah (save bandwidth)
! -------------------------------------------------------------------------------
||googleads.g.doubleclick.net^$domain=youtube.com
||static.doubleclick.net^$domain=youtube.com
||googleadservices.com^$domain=youtube.com
||youtube.com/pagead/*
||youtube.com/ptracking$domain=youtube.com
||youtube-nocookie.com/embed/*
||google-analytics.com/analytics.js$domain=youtube.com
||googletagservices.com^$domain=youtube.com

! -------------------------------------------------------------------------------
! DIMENSI 2: MANIPULASI RESPONS SERVER (SCRIPTLET INJECTION & RESPONSE PRUNING)
! Meretas objek JSON YouTube di memori sebelum pemutar video merender iklan
! -------------------------------------------------------------------------------
youtube.com##+js(set, ytInitialPlayerResponse.adPlacements, undefined)
youtube.com##+js(set, playerResponse.adPlacements, undefined)
youtube.com##+js(set, ytInitialPlayerResponse.playerAds, undefined)
youtube.com##+js(set, playerResponse.playerAds, undefined)
youtube.com##+js(json-prune, adPlacements playerAds playerResponse.adPlacements)
youtube.com##+js(json-prune, [].playerResponse.adPlacements)
youtube.com##+js(nowebrtc)

! -------------------------------------------------------------------------------
! DIMENSI 3: ANTI-ADBLOCK BYPASS & SCRIPTLET DEFUSER
! Mengelabui skrip pendeteksi YouTube agar player tidak memunculkan peringatan/keblokir
! -------------------------------------------------------------------------------
youtube.com##+js(set, google_ad_status, 1)
youtube.com##+js(set, yt.config_.EXPERIMENT_FLAGS.allow_muted_autoplay, true)
youtube.com##+js(set, yt.config_.EXPERIMENT_FLAGS.web_enable_ab_reg_app_errors, false)
youtube.com##+js(set, yt.config_.EXPERIMENT_FLAGS.disable_async_script_ad_inject, true)
youtube.com##+js(abort-on-property-write, ytInitialPlayerResponse.adPlacements)

! -------------------------------------------------------------------------------
! DIMENSI 4: PERLINDUNGAN PRIVASI & UNCLOAKING
! Menghapus atribut pelacakan URL dan menghentikan pengiriman telemetri
! -------------------------------------------------------------------------------
$removeparam=utm_source,domain=youtube.com
$removeparam=utm_medium,domain=youtube.com
$removeparam=utm_campaign,domain=youtube.com
$removeparam=si,domain=youtube.com
$removeparam=fbclid,domain=youtube.com
||youtube.com/api/stats/ads
||youtube.com/api/stats/atr
||youtube.com/api/stats/qoe$badfilter

! -------------------------------------------------------------------------------
