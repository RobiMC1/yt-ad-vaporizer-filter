! -------------------------------------------------------------------------------
! DIMENSI 1: AD MOCKING & STATUS ILUSI (Memberikan Respon Palsu "Iklan Sukses")
! -------------------------------------------------------------------------------
youtube.com##+js(set, google_ad_status, 1)
youtube.com##+js(set, yt.config_.EXPERIMENT_FLAGS.allow_muted_autoplay, true)
youtube.com##+js(set, yt.config_.EXPERIMENT_FLAGS.web_enable_ab_reg_app_errors, false)
youtube.com##+js(set, yt.config_.EXPERIMENT_FLAGS.disable_async_script_ad_inject, true)
youtube.com##+js(set, yt.config_.EXPERIMENT_FLAGS.enable_client_sli_for_vod, false)

! -------------------------------------------------------------------------------
! DIMENSI 2: REDIREKSI ENDPOINT TELEMETRI (Mencegah Error Network di Logs Server)
! -------------------------------------------------------------------------------
youtube.com##+js(set, ytInitialPlayerResponse.adPlacements, [])
youtube.com##+js(set, playerResponse.adPlacements, [])
youtube.com##+js(nowebrtc)

